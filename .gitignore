# Database (defn index, rebuilt from source)
.defn/
*.db

# Binaries
/winze
/benchmark
/lint
/sensor
/topology
/metabolism
/query
/add
/rot-probe
/predicates-suggest

# Generated configs (contain absolute paths)
.mcp.json

# Secrets
.env

# Sensor state (rebuilt on poll)
.sensor-state.json

# Metabolism log (rebuilt each cycle)
.metabolism-log.json

# Metabolism calibration time series (append-only, local trend signal)
.metabolism-calibration.jsonl

# Metabolism budget state (per-checkout monthly accounting)
.metabolism-budget.json

# Metabolism patrol progress counter (handoff-survival state)
.metabolism-tick-progress

# Rot-probe time series (append-only; one row per probe invocation)
.metabolism-rot-probe.jsonl

# Predicate-candidate proposals (overwritten each predicates-suggest run)
.metabolism-predicate-candidates.json

# Trip-cycle NONE-predicate connections (predicate-ontology gap log)
.metabolism-trip-isolated.jsonl

# Trip-cycle critic rulings — the calibration worksheet for the shallowness
# bar. Hand-edited during labelling, so it is local working state, not a
# committed artifact.
.metabolism-trip-verdicts.jsonl

# Bias audit snapshot (injected into --ask context at query time)
.metabolism-bias-state.json

# Calibration novelty snapshot (injected into --ask context at query time)
.metabolism-calibration-state.json

# Topology fragility snapshot (written by --dream for debugging; not injected into --ask)
.metabolism-topology-state.json

# Sensor config (contains local paths)
.metabolism.json

# Bleve search index (built from ZIM, large)
*.bleve/

# PKM ingest output (generated, re-run --pkm to recreate)
# Only ignore the generated corpus output — cmd/metabolism/pkm_test.go is a real
# test file. The corpus lives in corpus/, so the generated files land there.
/pkm_*.go
/corpus/pkm_*.go

# Demo recordings (generated by script/demo.sh)
demo/*.cast
demo/*.gif
demo/*.svg

# Beads runtime
.beads/embeddeddolt/
.beads/locks/
.beads/metadata.json
.beads/.gt-types-configured
.beads/formulas/.installed.json

# OS
.DS_Store

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Debug artifacts
.plancheck-debug.json

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# Gas Town runtime state
.dolt-data/
daemon/
settings/
rigs.json

# Stray Claude session dirs
 /

# Gas Town polecat worktrees (runtime, not source)
polecats/

# Gas Town (added by gt)
.runtime/
.claude/
.logs/
__pycache__/
state.json
CLAUDE.md
CLAUDE.local.md

# Built tool binaries (make build)
bin/

# corpus-wide advisory write lock (internal/corpuslock)
.winze.lock

# semantic search embedding cache (cmd/query --semantic)
.winze-embed/

# self-telemetry (usage-frequency log; local only)
.winze-usage.jsonl

# observatory JS tooling
cmd/observatory/node_modules/

# LongMemEval dataset (fetched via cmd/longmemeval/fetch-data.sh, not committed)
/cmd/longmemeval/data/
